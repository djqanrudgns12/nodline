{
  "name": "노드라인 (Nodeline)",
  "short_name": "노드라인",
  "version": "1.0.0",
  "description": "산과 강 지형 위에 지하철 노선을 구축하고 승객을 수송하는 2D 지하철 운영 시뮬레이션",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F8F6F0",
  "theme_color": "#15529E",
  "icons": [
    {
      "src": "icons/favicon-48x48.png",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
