; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="노드라인 (Nodeline)"
config/version="1.0.0"
config/description="플레이어가 지하철 노선을 연결하고 열차를 운행하여 승객을 목적지까지 이동시키는 2D 시뮬레이션 게임"
run/main_scene="res://app/presentation/scenes/main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://app/domain/events/event_bus.gd"
GameLogger="*res://app/infrastructure/game_logger.gd"
GameConfig="*res://data/balance/game_config.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

